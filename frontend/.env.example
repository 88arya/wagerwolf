# Frontend environment. NEXT_PUBLIC_* values are compiled into the client
# bundle at build time, so none of them may be secret.

# Backend base URL, no trailing slash.
NEXT_PUBLIC_API_URL="https://api.wagerwolf.app"

# Optional. Falls back to the client ID hardcoded in lib/googleAuth.ts.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Optional. Browser/server error reporting; off when empty.
NEXT_PUBLIC_SENTRY_DSN=""
