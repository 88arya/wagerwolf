# Frontend environment.
#
# Set these in the Vercel project's Environment Variables, scoped separately to
# Preview (staging) and Production. NEXT_PUBLIC_* values are inlined into the
# client bundle at build time — they are public, and none of them may be secret.
#
# The deploy workflow runs `vercel pull` and `vercel build`, so the build reads
# these from Vercel rather than from the workflow. Setting them in the workflow
# YAML instead would have no effect.

# Base URL of the deployed backend, no trailing slash.
# This must differ between Preview and Production, or staging will read and
# write the production database.
NEXT_PUBLIC_API_URL="https://api.wagerwolf.app"

# Google OAuth client ID. Public by design — it appears in every authorization
# URL. Optional: frontend/lib/googleAuth.ts falls back to a hardcoded value when
# this is unset, so the app works without it. Set it if staging and production
# should use separate OAuth clients.
#
# Whichever client is used, EVERY origin that serves the app needs its
# /auth/callback registered under "Authorized redirect URIs" in Google Cloud
# Console — localhost, the staging domain, and production. Google refuses with
# redirect_uri_mismatch before the chooser appears otherwise.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
