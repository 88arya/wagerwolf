# TLS uses a Cloudflare Origin certificate (Cloudflare proxies all traffic),
# so automatic HTTPS is off for these sites.

# API.
{$BACKEND_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	# Bounded waits so a stalled app can't make Caddy hold requests until it runs
	# out of memory.
	reverse_proxy app:5000 {
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}

	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# Redact the load-test key from access logs.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>X-Loadtest-Key delete
			}
		}
	}
}

# The Next.js site, same box and same Caddy as the API.
{$APP_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy web:3000
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
	}
}

# www redirects to the canonical URL (a full URL, scheme included).
{$WWW_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	redir {$CANONICAL_URL}{uri} 308
}
