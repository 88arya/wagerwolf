# Backend environment.
#
# In production these are not set individually anywhere: the whole file is one
# GitHub Environment secret, BACKEND_ENV, which the deploy writes to
# /opt/wagerwolf/.env on the instance. See .github/DEPLOYMENT.md.
#
# The three marked REQUIRED are checked at boot in src/index.ts — the process
# exits rather than failing later on whichever request happens to need one.

# REQUIRED. Postgres — Supabase, not a database on the app server.
#
# USE THE SESSION-MODE POOLER (port 5432 on aws-N-<region>.pooler.supabase.com).
# Transaction mode is port 6543 and silently breaks prepared statements and
# drizzle-kit; the failure looks like an intermittent query bug, not a config
# error. Supabase Dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# REQUIRED. Redis, backing the BullMQ scheduler. The app will not boot without
# it. In the deployed stack this is the compose service: redis://redis:6379
REDIS_URL="redis://localhost:6379"

# REQUIRED. Signs the 30-day auth JWTs. Generate a fresh value per environment —
# `openssl rand -hex 32` — and never reuse the dev placeholder. Rotating this
# invalidates every signed-in session, which is the only revocation mechanism
# this app has.
JWT_SECRET="change-me"

# Google OAuth client ID. Public (it appears in every authorization URL), so it
# may match the value in frontend/lib/googleAuth.ts.
GOOGLE_CLIENT_ID=""

# Google OAuth client SECRET — a real secret, never sent to the frontend.
# Required by the auth-code flow: the browser receives an authorization code and
# POST /users/auth/google exchanges it here. Without it, sign-in answers 500
# "Google sign-in is not configured".
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Web client.
GOOGLE_CLIENT_SECRET=""

# Required on the `x-cron-secret` header for the emergency-override routes
# (POST /espn/resolve/:weekId, /espn/games/:weekId, /sync/week/:weekId,
# /weeks/:id/resolve). Those routes settle everyone's bets.
# Unset in production, requireCron now answers 503 rather than passing the
# request through — set this, or the manual overrides do not exist.
CRON_SECRET="change-me"

# Comma-separated allowed CORS origins — the deployed frontend URL(s). Doubles
# as the allowlist `resolveRedirectUri` checks the OAuth redirect against, so
# one list governs both. UNSET MEANS ANY ORIGIN IS REFLECTED, which the
# production smoke check in .github/workflows/deploy-production.yml fails on.
# Include every host that serves the app, e.g. the apex and the vercel.app URL.
FRONTEND_URL="https://wagerwolf.app,https://wagerwolf.vercel.app"

# Set by the platform. Governs the fail-closed cron behaviour above and the
# boot-time warnings.
NODE_ENV="production"

# SportsGameOdds — the odds feed (https://sportsgameodds.com). Quota is per
# *entity* (one event returned), not per request; 2500/month on the amateur
# tier, and the poller is tuned against that ceiling.
# NOTE: staging and production sharing one key share one quota. Two environments
# both running the 30-minute poller will roughly double consumption and can
# exhaust the month — either give staging its own key, or leave it unset there
# and let the odds sync no-op.
SPORTSGAMEODDS_KEY=""

# Optional. Reported by GET /health so a deploy can confirm which commit is
# serving. The GitHub Actions deploy sets it; unset locally, which is correct.
GIT_COMMIT_SHA=""

# Hostname Caddy serves on, which is what switches on automatic HTTPS. Set to
# ":80" to serve plain HTTP while DNS is still propagating. Deployed stack only;
# meaningless locally.
BACKEND_DOMAIN="api.wagerwolf.app"
