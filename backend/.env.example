# Postgres connection string
DATABASE_URL="postgres://user:password@host:5432/fanmark"

# Redis connection string (BullMQ scheduler will not start without this)
REDIS_URL="redis://host:6379"

# Generate a fresh random value for production — do NOT reuse the dev default.
# e.g. `openssl rand -hex 32`
JWT_SECRET="change-me"

# SharpAPI odds provider key — required for real odds sync (syncOddsAllWeeks).
# Leave unset to fall back to fakeSync-only (dev/demo mode).
SHARPAPI_KEY=""

# Google OAuth client ID — must match the value hardcoded in
# frontend/components/GoogleProvider.tsx (client IDs are public, not secret).
GOOGLE_CLIENT_ID=""

# Google OAuth client SECRET. Unlike the ID above this is a real secret and must
# never reach the frontend. Required by the auth-code flow: the sign-in modal
# draws its own buttons, so Google hands the browser an authorization code
# rather than an ID token, and POST /users/auth/google exchanges that code here.
# Without it, sign-in answers 500 "Google sign-in is not configured".
# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth 2.0 Web
# client -> Client secret.
GOOGLE_CLIENT_SECRET=""

# Shared secret required on the `x-cron-secret` header for the emergency-override
# routes (POST /espn/resolve/:weekId, /espn/games/:weekId, /sync/week/:weekId,
# /weeks/:id/resolve). Open/unauthenticated if unset — MUST be set in production.
CRON_SECRET="change-me"

# Comma-separated list of allowed CORS origins (the deployed frontend URL).
# Falls back to reflecting any origin if unset — fine for dev, not for prod.
FRONTEND_URL="https://your-frontend.vercel.app"

# Set by the hosting platform; only used to decide whether to warn about a
# missing CRON_SECRET at boot.
NODE_ENV="production"

# SportsGameOdds — odds feed (https://sportsgameodds.com). Quota is per *entity*
# (one event returned), not per request; 2500/month on the amateur tier.
SPORTSGAMEODDS_KEY=""
