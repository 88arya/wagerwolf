# Backend environment. In production this whole file is the BACKEND_ENV secret.
# The REQUIRED ones are checked at boot.

# REQUIRED. Supabase session-mode pooler (port 5432). Transaction mode (6543)
# breaks prepared statements and drizzle-kit.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# REQUIRED. Redis for BullMQ. redis://redis:6379 in the compose stack.
REDIS_URL="redis://localhost:6379"

# REQUIRED. JWT signing key: `openssl rand -hex 32`. Rotating it signs everyone out.
JWT_SECRET="change-me"

# Google OAuth client ID (public).
GOOGLE_CLIENT_ID=""

# Google OAuth client secret, used to exchange the auth code.
GOOGLE_CLIENT_SECRET=""

# Required in the x-cron-secret header for the manual resolve/sync routes.
# If unset in production those routes return 503.
CRON_SECRET="change-me"

# Comma-separated allowed origins, for CORS and the OAuth redirect check.
# Unset reflects any origin.
FRONTEND_URL="https://wagerwolf.app,https://wagerwolf.vercel.app"

NODE_ENV="production"

# SportsGameOdds API key. Quota is 2500 entities/month; staging and
# production share it if they share a key.
SPORTSGAMEODDS_KEY=""

# Optional. Reported by /health; set by the deploy.
GIT_COMMIT_SHA=""

# Hostname Caddy serves on (deployed stack only).
BACKEND_DOMAIN="api.wagerwolf.app"

# Support mail (optional). Without these, messages are stored but not sent.
RESEND_API_KEY=
SUPPORT_FROM=support@wagerwolf.app
SUPPORT_INBOX=

# Monitoring (optional). Each is off when empty.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
HEALTHCHECKS_PING_KEY=

# Load testing (optional). Requests with x-loadtest-key: <this> skip the
# global rate limiter. Leave unset normally.
LOADTEST_KEY=
