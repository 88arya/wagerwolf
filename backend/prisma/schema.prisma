generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatType {
  PASSING_YARDS
  PASSING_TOUCHDOWNS
  PASSING_COMPLETIONS
  PASSING_ATTEMPTS
  PASSING_INTERCEPTIONS
  PASSING_LONGEST
  RUSHING_YARDS
  RUSHING_TOUCHDOWNS
  RUSHING_ATTEMPTS
  RUSHING_LONGEST
  RECEIVING_YARDS
  RECEIVING_TOUCHDOWNS
  RECEIVING_LONGEST
  RECEIVING_TARGETS
  RECEPTIONS
  SACKS
  TACKLES_ASSISTS
  DEFENSIVE_INTERCEPTIONS
  FIELD_GOALS_MADE
  FIELD_GOAL_LONGEST
  KICKING_POINTS
  EXTRA_POINTS_MADE
  TOUCHDOWNS
}

enum Direction {
  OVER
  UNDER
}

enum MembershipStatus {
  PENDING
  ACTIVE
}

enum Outcome {
  PENDING
  WIN
  LOSS
  VOID
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  password     String
  name         String
  displayName  String
  isAdmin      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  memberships  Membership[]
  picks        Pick[]
  gamePicks    GamePick[]
  parlays      Parlay[]
  leagues      League[]    @relation("LeagueCreator")
  homeMatchups Matchup[]   @relation("HomeMatchups")
  awayMatchups Matchup[]   @relation("AwayMatchups")
  messages     LeagueMessage[]
  resetTokens  PasswordResetToken[]
}

model League {
  id                 String      @id @default(cuid())
  name               String
  weeklyAllowance    Int
  inviteCode         String      @unique
  creatorId          String
  seasonStarted      Boolean     @default(false)
  seasonEnded        Boolean     @default(false)
  championId         String?
  isPublic           Boolean     @default(false)
  maxTeams           Int         @default(10)
  startWeek          Int         @default(1)
  regularSeasonWeeks Int         @default(13)
  playoffWeeks       Int         @default(3)
  playoffSize        Int         @default(4)
  consolationTeams   Int         @default(6)
  consolationWeeks   Int         @default(2)
  hasGhost           Boolean     @default(false)
  autoStartAt        DateTime?
  maxPublicPlayers   Int         @default(0)
  maxStakePerBet     Int?
  maxBetsPerWeek     Int?
  maxParlayLegs      Int?        @default(10)
  feedVisibility     String      @default("AFTER_KICKOFF")
  creator            User        @relation("LeagueCreator", fields: [creatorId], references: [id])
  createdAt          DateTime    @default(now())
  memberships        Membership[]
  picks              Pick[]
  gamePicks          GamePick[]
  parlays            Parlay[]
  matchups           Matchup[]
  messages           LeagueMessage[]
}

model Matchup {
  id              String   @id @default(cuid())
  leagueId        String
  weekNumber      Int
  homeUserId      String
  awayUserId      String
  homeProfit      Int?
  awayProfit      Int?
  winnerId        String?
  isTie           Boolean  @default(false)
  isBye           Boolean  @default(false)
  isPlayoff       Boolean  @default(false)
  isConsolation   Boolean  @default(false)
  isGhostMatchup  Boolean  @default(false)
  playoffRound    Int?
  createdAt       DateTime @default(now())

  league   League @relation(fields: [leagueId], references: [id])
  homeUser User   @relation("HomeMatchups", fields: [homeUserId], references: [id])
  awayUser User   @relation("AwayMatchups", fields: [awayUserId], references: [id])

  @@unique([leagueId, weekNumber, homeUserId])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  leagueId       String
  balance        Int
  weeklyWinnings Int              @default(0)
  status         MembershipStatus @default(ACTIVE)
  isPublicFill   Boolean          @default(false)
  helmetColor    String           @default("#2563EB")
  displayName    String           @default("")
  abbreviation   String           @default("")
  createdAt      DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id])
  league League @relation(fields: [leagueId], references: [id])

  @@unique([userId, leagueId])
}

model Week {
  id        String   @id @default(cuid())
  number    Int      @unique
  startDate DateTime
  endDate   DateTime
  resolved  Boolean  @default(false)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  games     Game[]
}

model Game {
  id         String     @id @default(cuid())
  weekId     String
  homeTeam   String
  awayTeam   String
  gameDate   DateTime
  status     String     @default("SCHEDULED") // SCHEDULED | LIVE | FINAL | CANCELLED
  externalId String?    @unique
  espnId     String?    @unique
  homeScore  Int?
  awayScore  Int?
  week       Week       @relation(fields: [weekId], references: [id])
  props      Prop[]
  gameLines  GameLine[]
}

model Player {
  id       String  @id @default(cuid())
  name     String
  team     String
  position String
  espnId   String? @unique
  imageUrl String?
  props    Prop[]
}

model Prop {
  id         String     @id @default(cuid())
  gameId     String
  playerId   String
  statType   StatType
  line       Float
  odds       Int        @default(-110)
  result     Float?
  game       Game       @relation(fields: [gameId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])
  picks      Pick[]
  parlayLegs ParlayLeg[]
}

model Pick {
  id         String    @id @default(cuid())
  userId     String
  leagueId   String
  propId     String
  direction  Direction
  stake      Int
  odds       Int       @default(-110)
  altLine    Float?
  outcome    Outcome   @default(PENDING)
  cashedOut  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  league League @relation(fields: [leagueId], references: [id])
  prop   Prop   @relation(fields: [propId], references: [id])
}

// Game-level markets: moneyline, spread, totals
model GameLine {
  id         String     @id @default(cuid())
  gameId     String
  market     String     // MONEYLINE_HOME | MONEYLINE_AWAY | SPREAD_HOME | SPREAD_AWAY | TOTAL_OVER | TOTAL_UNDER
  label      String     // "Chiefs -6.5", "Over 48.5"
  odds       Int        // American: -110, +150
  line       Float?     // spread or total point value
  result     Boolean?   // true=won, false=lost, null=pending
  game       Game       @relation(fields: [gameId], references: [id])
  gamePicks  GamePick[]
  parlayLegs ParlayLeg[]

  @@unique([gameId, market])
}

model GamePick {
  id         String   @id @default(cuid())
  userId     String
  leagueId   String
  gameLineId String
  stake      Int
  odds       Int
  altLine    Float?
  outcome    Outcome  @default(PENDING)
  cashedOut  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  league   League   @relation(fields: [leagueId], references: [id])
  gameLine GameLine @relation(fields: [gameLineId], references: [id])
}

model Parlay {
  id        String      @id @default(cuid())
  userId    String
  leagueId  String
  stake     Int
  totalOdds Int
  payout    Int         // pre-calculated total return on win
  outcome   Outcome     @default(PENDING)
  cashedOut Boolean     @default(false)
  createdAt DateTime    @default(now())
  legs      ParlayLeg[]

  user   User   @relation(fields: [userId], references: [id])
  league League @relation(fields: [leagueId], references: [id])
}

model ParlayLeg {
  id         String     @id @default(cuid())
  parlayId   String
  propId     String?
  gameLineId String?
  direction  Direction?
  odds       Int
  altLine    Float?
  outcome    Outcome    @default(PENDING)

  parlay   Parlay    @relation(fields: [parlayId], references: [id])
  prop     Prop?     @relation(fields: [propId], references: [id])
  gameLine GameLine? @relation(fields: [gameLineId], references: [id])
}

model LeagueMessage {
  id        String   @id @default(cuid())
  leagueId  String
  userId    String
  body      String
  createdAt DateTime @default(now())
  league    League   @relation(fields: [leagueId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
